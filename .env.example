# Copier ce fichier en .env sur le VPS et renseigner les vraies valeurs.
# Ne jamais commiter le .env réel.

# --- Nom de domaine pointant vers ce VPS (pour Caddy / TLS) ---
API_DOMAIN=api.tondomaine.com

# --- Base de données ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/benin_explo
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# --- JWT ---
JWT_SECRET=une_cle_secrete_longue_et_aleatoire_minimum_32_caracteres

# --- CORS (origines autorisées, séparées par des virgules) ---
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://frontend-benin-explo.netlify.app,https://*.netlify.app

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=benin-explo

# --- PayPal ---
PAYPAL_ENABLED=true
PAYPAL_SANDBOX=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR
PAYPAL_BRAND_NAME=Benin Explo
PAYPAL_LOCALE=fr-FR
PAYPAL_WEBHOOK_ID=

# --- Emails transactionnels ---
CONTACT_MAIL_ENABLED=true
RESERVATION_MAIL_ENABLED=true
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Premier compte admin (bootstrap) ---
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
